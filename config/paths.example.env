# Copy to config/paths.local.env (not tracked by git), fill in your paths, then load before running:
#   set -a; source config/paths.local.env; set +a
# SLURM jobs inherit these variables when submitted from the same shell (sbatch exports the environment by default).

# Code and main working directory
HDC_CODE=/path/to/HDC_Multiome_Analysis/scripts   # this repository's scripts folder
HDC_DIR=/path/to/data/HDC                         # analysis directory: inputs (MultiVI/*.h5ad) and all outputs

# Inputs
GENOTYPE_DIR=/path/to/data/genotypes              # Genotype/plink/chr*.{pgen,pvar,psam}, EB_Multiome_highpass_individuals.txt, igsr-yri.tsv.tsv
GENOTYPE_PCS=/path/to/data/genotypes/human.YRI.hg38.eigenvec
GWAS_DIR=/path/to/data/gwas                       # harmonized GWAS summary statistics, hg38ToHg19.over.chain
GTEX_DIR=/path/to/data/GTEx_Analysis_v8_eQTL      # GTEx v8 *.signif_variant_gene_pairs.txt.gz
BRAIN_CAQTL_DIR=/path/to/data/brain_caqtl         # adult brain neuron / glia caQTL summary statistics
PSEUDOTIME_FILE=/path/to/data/highres_slingshot_pseudotimes.tsv
TF_LIST=/path/to/data/human_tf.txt                # human TF list (column Symbol)
GENOME_FA=/path/to/data/hg38.fa
LDSC_REF_DIR=/path/to/data/ldsc_reference         # baselineLD v2.2, 1000G EUR / EAS plink files, weights, frq (Zenodo 10515792)

# Software
PYTHON=/path/to/envs/tensorqtl/bin/python         # main Python environment (tensorqtl, torch, pandas, scipy, pyarrow)
PYTHON_SCVI=/path/to/envs/scvi/bin/python         # Python with h5py / anndata (01_pseudobulk.py)
LDSC_PYTHON=/path/to/envs/ldsc_py27/bin/python    # Python 2.7 for ldsc
LDSC_SCRIPT=/path/to/ldsc/ldsc.py
TOOLS_ENV=/path/to/envs/peakannot                 # environment with bedtools and HOMER
TOOLS_BIN=/path/to/envs/peakannot/bin
HOMER_MOTIFS=/path/to/envs/peakannot/share/homer/data/knownTFs/vertebrates/known.motifs
SPIRE_DIR=/path/to/spire                          # SPIRE package checkout
SPIRE_SRC=/path/to/spire/src
